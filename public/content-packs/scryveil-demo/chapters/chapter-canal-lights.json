      "blocks": [
        {
          "id": "block-021",
          "type": "narration",
          "text": "Cuando llegó la noche, pequeñas luces comenzaron a navegar contra la corriente."
        },
        {
          "id": "block-022",
          "type": "memory",
          "text": "Recordó entonces el andén vacío y una promesa que todavía no comprendía."
