          "id": "block-018",
          "type": "narration",
          "text": "El sol descendió entre las cubiertas y dejó una franja de cobre sobre el agua inmóvil."
        },
        {
          "id": "block-019",
          "type": "dialogue",
          "characterId": "character-002",
          "speakerLabel": "Cartógrafa",
          "text": "—Mañana quizá tengas que llamarme de otra manera."
